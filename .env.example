# Jayaasi Rooms — Environment Configuration Template
# Copy this file to .env and configure local values

# PostgreSQL Connection String (Direct or pooled connection)
DATABASE_URL="postgresql://username:password@localhost:5432/jayaasi_rooms?schema=public"

# Optional: Direct connection for Prisma Migrations (when using connection pooling like Supabase/PgBouncer)
DIRECT_URL="postgresql://username:password@localhost:5432/jayaasi_rooms?schema=public"

# Hotel Context Defaults
DEFAULT_HOTEL_SLUG="jayaasi-rooms"
