# Jayaasi Rooms — Environment Configuration Template
# Copy this file to .env and configure local values

# PostgreSQL Connection String (Direct or pooled connection)
DATABASE_URL="postgresql://username:password@localhost:5432/jayaasi_rooms?schema=public"

# Optional: Direct connection for Prisma Migrations (when using connection pooling like Supabase/PgBouncer)
DIRECT_URL="postgresql://username:password@localhost:5432/jayaasi_rooms?schema=public"

# Hotel Context Defaults
DEFAULT_HOTEL_SLUG="jayaasi-rooms"

# ─── QR & Session System ─────────────────────────────────────────────────────
# Base URL for permanent QR codes (what is encoded in the QR image)
# e.g. https://jayaasi.com for production, http://localhost:3000 for dev
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Salt for hashing client IPs in rate limiting and session storage
# Use a long random string — keep secret, rotate occasionally
IP_SALT="change-this-to-a-long-random-secret"

# Session duration in seconds (default: 60)
# ROOM_SESSION_DURATION_SECONDS=60
