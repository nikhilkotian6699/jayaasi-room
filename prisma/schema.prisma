// Jayaasi Rooms — Production Prisma Schema
// PostgreSQL Relational System of Record

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  IN_PROGRESS
  INSPECTED
}

enum StayStatus {
  RESERVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum StaffRole {
  SUPER_ADMIN
  HOTEL_ADMIN
  MANAGER
  RECEPTION
  HOUSEKEEPING
  KITCHEN
  LAUNDRY
  CONCIERGE
  CAB_OPERATOR
  STAFF
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  NEW
  ACCEPTED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum Department {
  KITCHEN
  HOUSEKEEPING
  LAUNDRY
  BELL_DESK
  TRANSPORT
  CONCIERGE
  RETAIL
}

enum FolioStatus {
  OPEN
  SETTLED
  VOID
  CLOSED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum DietaryType {
  VEG
  NON_VEG
  JAIN
  VEGAN
}

// ─────────────────────────────────────────────────────────────
// HOTEL & PROPERTY
// ─────────────────────────────────────────────────────────────

model Hotel {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  code        String   @unique @db.VarChar(30)
  legalName   String   @map("legal_name") @db.VarChar(150)
  address     String   @db.Text
  city        String   @db.VarChar(100)
  state       String   @db.VarChar(100)
  country     String   @default("India") @db.VarChar(100)
  postalCode  String   @map("postal_code") @db.VarChar(20)
  phone       String   @db.VarChar(30)
  email       String   @db.VarChar(150)
  website     String?  @db.VarChar(255)
  gstin       String?  @unique @db.VarChar(30)
  currency    String   @default("INR") @db.VarChar(10)
  timezone    String   @default("Asia/Kolkata") @db.VarChar(50)
  logoUrl     String?  @map("logo_url") @db.VarChar(255)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  roomTypes         RoomType[]
  rooms             Room[]
  staff             StaffUser[]
  stays             Stay[]
  guestSessions     GuestSession[]
  serviceCategories ServiceCategory[]
  services          Service[]
  products          Product[]
  carts             Cart[]
  orders            Order[]
  serviceRequests   ServiceRequest[]
  folios            Folio[]
  invoices          Invoice[]
  payments          Payment[]
  taxConfigs        TaxConfig[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@map("hotels")
}

model RoomType {
  id          String   @id @default(uuid()) @db.Uuid
  hotelId     String   @map("hotel_id") @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(30)
  description String?  @db.Text
  maxAdults   Int      @default(2) @map("max_adults")
  maxChildren Int      @default(1) @map("max_children")
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  hotel Hotel  @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  rooms Room[]

  @@unique([hotelId, code])
  @@index([hotelId, active])
  @@map("room_types")
}

model Room {
  id                 String             @id @default(uuid()) @db.Uuid
  hotelId            String             @map("hotel_id") @db.Uuid
  roomTypeId         String             @map("room_type_id") @db.Uuid
  floor              String             @db.VarChar(20)
  roomNumber         String             @map("room_number") @db.VarChar(20)
  displayName        String             @map("display_name") @db.VarChar(100)
  status             RoomStatus         @default(AVAILABLE)
  housekeepingStatus HousekeepingStatus @default(CLEAN) @map("housekeeping_status")
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  hotel           Hotel            @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  roomType        RoomType         @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  stays           Stay[]
  guestSessions   GuestSession[]
  orders          Order[]
  serviceRequests ServiceRequest[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId, status])
  @@index([hotelId, floor])
  @@map("rooms")
}

// ─────────────────────────────────────────────────────────────
// IDENTITY, GUESTS & STAFF
// ─────────────────────────────────────────────────────────────

model Guest {
  id          String   @id @default(uuid()) @db.Uuid
  firstName   String   @map("first_name") @db.VarChar(60)
  lastName    String   @map("last_name") @db.VarChar(60)
  email       String?  @db.VarChar(150)
  phone       String   @db.VarChar(30)
  countryCode String   @default("+91") @map("country_code") @db.VarChar(10)
  vip         Boolean  @default(false)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  stays           Stay[]
  guestSessions   GuestSession[]
  orders          Order[]
  serviceRequests ServiceRequest[]
  notifications   Notification[]

  @@index([phone])
  @@index([email])
  @@map("guests")
}

model StaffUser {
  id        String    @id @default(uuid()) @db.Uuid
  hotelId   String    @map("hotel_id") @db.Uuid
  name      String    @db.VarChar(100)
  email     String    @unique @db.VarChar(150)
  phone     String?   @db.VarChar(30)
  role      StaffRole @default(STAFF)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  hotel           Hotel            @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  assignedRequests ServiceRequest[]
  auditLogs       AuditLog[]
  notifications   Notification[]

  @@index([hotelId, role])
  @@map("staff_users")
}

model Stay {
  id                  String     @id @default(uuid()) @db.Uuid
  hotelId             String     @map("hotel_id") @db.Uuid
  guestId             String     @map("guest_id") @db.Uuid
  roomId              String     @map("room_id") @db.Uuid
  bookingReference    String     @unique @map("booking_reference") @db.VarChar(50)
  checkInAt           DateTime   @map("check_in_at") @db.Timestamptz(6)
  expectedCheckOutAt  DateTime   @map("expected_check_out_at") @db.Timestamptz(6)
  actualCheckOutAt    DateTime?  @map("actual_check_out_at") @db.Timestamptz(6)
  status              StayStatus @default(CHECKED_IN)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  hotel           Hotel            @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  guest           Guest            @relation(fields: [guestId], references: [id], onDelete: Restrict)
  room            Room             @relation(fields: [roomId], references: [id], onDelete: Restrict)
  sessions        GuestSession[]
  orders          Order[]
  serviceRequests ServiceRequest[]
  folio           Folio?
  invoices        Invoice[]
  payments        Payment[]

  @@index([hotelId, status])
  @@index([guestId])
  @@index([roomId])
  @@map("stays")
}

model GuestSession {
  id         String    @id @default(uuid()) @db.Uuid
  hotelId    String    @map("hotel_id") @db.Uuid
  stayId     String    @map("stay_id") @db.Uuid
  roomId     String    @map("room_id") @db.Uuid
  guestId    String    @map("guest_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  hotel Hotel  @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  stay  Stay   @relation(fields: [stayId], references: [id], onDelete: Cascade)
  room  Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guest Guest  @relation(fields: [guestId], references: [id], onDelete: Restrict)
  carts Cart[]

  @@index([hotelId, stayId])
  @@index([tokenHash])
  @@map("guest_sessions")
}

// ─────────────────────────────────────────────────────────────
// SERVICES & CATALOG
// ─────────────────────────────────────────────────────────────

model ServiceCategory {
  id           String   @id @default(uuid()) @db.Uuid
  hotelId      String   @map("hotel_id") @db.Uuid
  name         String   @db.VarChar(100)
  code         String   @db.VarChar(30)
  description  String?  @db.Text
  displayOrder Int      @default(0) @map("display_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  services Service[]
  products Product[]

  @@unique([hotelId, code])
  @@index([hotelId, active, displayOrder])
  @@map("service_categories")
}

model Service {
  id           String     @id @default(uuid()) @db.Uuid
  hotelId      String     @map("hotel_id") @db.Uuid
  categoryId   String     @map("category_id") @db.Uuid
  name         String     @db.VarChar(120)
  code         String     @db.VarChar(40)
  description  String?    @db.Text
  price        Decimal    @default(0.00) @db.Decimal(10, 2)
  taxCode      String     @default("GST-5") @map("tax_code") @db.VarChar(20)
  imageUrl     String?    @map("image_url") @db.VarChar(255)
  department   Department
  displayOrder Int        @default(0) @map("display_order")
  active       Boolean    @default(true)
  available    Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  hotel           Hotel            @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  category        ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  foodDetails     FoodMenuItem?
  cartItems       CartItem[]
  orderItems      OrderItem[]
  serviceRequests ServiceRequest[]

  @@unique([hotelId, code])
  @@index([hotelId, categoryId, active])
  @@index([department])
  @@map("services")
}

model FoodMenuItem {
  id              String      @id @default(uuid()) @db.Uuid
  serviceId       String      @unique @map("service_id") @db.Uuid
  dietaryType     DietaryType @default(VEG) @map("dietary_type")
  spiceLevel      Int         @default(1) @map("spice_level")
  prepTimeMinutes Int         @default(20) @map("prep_time_minutes")
  subCuisine      String?     @map("sub_cuisine") @db.VarChar(50)

  // Relations
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("food_menu_items")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  hotelId       String   @map("hotel_id") @db.Uuid
  categoryId    String?  @map("category_id") @db.Uuid
  name          String   @db.VarChar(120)
  sku           String   @db.VarChar(50)
  description   String?  @db.Text
  price         Decimal  @db.Decimal(10, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  available     Boolean  @default(true)
  imageUrl      String?  @map("image_url") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  hotel      Hotel            @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([hotelId, sku])
  @@index([hotelId, available])
  @@map("products")
}

// ─────────────────────────────────────────────────────────────
// CART & ORDERING
// ─────────────────────────────────────────────────────────────

model Cart {
  id                  String   @id @default(uuid()) @db.Uuid
  hotelId             String   @map("hotel_id") @db.Uuid
  guestSessionId      String   @map("guest_session_id") @db.Uuid
  specialInstructions String?  @map("special_instructions") @db.Text
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  hotel        Hotel        @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  guestSession GuestSession @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  items        CartItem[]

  @@index([guestSessionId])
  @@map("carts")
}

model CartItem {
  id                String   @id @default(uuid()) @db.Uuid
  cartId            String   @map("cart_id") @db.Uuid
  serviceId         String?  @map("service_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  quantity          Int      @default(1)
  unitPriceSnapshot Decimal  @map("unit_price_snapshot") @db.Decimal(10, 2)
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  cart    Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  hotelId       String      @map("hotel_id") @db.Uuid
  stayId        String      @map("stay_id") @db.Uuid
  guestId       String      @map("guest_id") @db.Uuid
  roomId        String      @map("room_id") @db.Uuid
  orderNumber   String      @unique @map("order_number") @db.VarChar(50)
  status        OrderStatus @default(CONFIRMED)
  subtotal      Decimal     @db.Decimal(10, 2)
  taxTotal      Decimal     @map("tax_total") @db.Decimal(10, 2)
  discountTotal Decimal     @default(0.00) @map("discount_total") @db.Decimal(10, 2)
  grandTotal    Decimal     @map("grand_total") @db.Decimal(10, 2)
  notes         String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  hotel           Hotel            @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  stay            Stay             @relation(fields: [stayId], references: [id], onDelete: Restrict)
  guest           Guest            @relation(fields: [guestId], references: [id], onDelete: Restrict)
  room            Room             @relation(fields: [roomId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  serviceRequests ServiceRequest[]
  folioCharges    FolioCharge[]

  @@index([hotelId, status])
  @@index([stayId])
  @@index([roomId])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  serviceId    String?  @map("service_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  nameSnapshot String   @map("name_snapshot") @db.VarChar(120)
  quantity     Int
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  taxRate      Decimal  @default(5.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount    Decimal  @map("tax_amount") @db.Decimal(10, 2)
  lineTotal    Decimal  @map("line_total") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────
// OPERATIONS & SERVICE REQUEST DISPATCH
// ─────────────────────────────────────────────────────────────

model ServiceRequest {
  id              String        @id @default(uuid()) @db.Uuid
  hotelId         String        @map("hotel_id") @db.Uuid
  stayId          String        @map("stay_id") @db.Uuid
  roomId          String        @map("room_id") @db.Uuid
  guestId         String        @map("guest_id") @db.Uuid
  orderId         String?       @map("order_id") @db.Uuid
  serviceId       String?       @map("service_id") @db.Uuid
  requestNumber   String        @unique @map("request_number") @db.VarChar(50)
  department      Department
  status          RequestStatus @default(NEW)
  priority        String        @default("NORMAL") @db.VarChar(20)
  assignedStaffId String?       @map("assigned_staff_id") @db.Uuid
  requestedAt     DateTime      @default(now()) @map("requested_at") @db.Timestamptz(6)
  acceptedAt      DateTime?     @map("accepted_at") @db.Timestamptz(6)
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(6)
  notes           String?       @db.Text

  // Relations
  hotel         Hotel      @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  stay          Stay       @relation(fields: [stayId], references: [id], onDelete: Restrict)
  room          Room       @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guest         Guest      @relation(fields: [guestId], references: [id], onDelete: Restrict)
  order         Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  service       Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  assignedStaff StaffUser? @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([hotelId, department, status])
  @@index([roomId, status])
  @@index([stayId])
  @@map("service_requests")
}

// ─────────────────────────────────────────────────────────────
// BILLING, FOLIOS & INVOICES
// ─────────────────────────────────────────────────────────────

model Folio {
  id            String      @id @default(uuid()) @db.Uuid
  hotelId       String      @map("hotel_id") @db.Uuid
  stayId        String      @unique @map("stay_id") @db.Uuid
  folioNumber   String      @unique @map("folio_number") @db.VarChar(50)
  status        FolioStatus @default(OPEN)
  subtotal      Decimal     @default(0.00) @db.Decimal(10, 2)
  taxTotal      Decimal     @default(0.00) @map("tax_total") @db.Decimal(10, 2)
  discountTotal Decimal     @default(0.00) @map("discount_total") @db.Decimal(10, 2)
  grandTotal    Decimal     @default(0.00) @map("grand_total") @db.Decimal(10, 2)
  settledAt     DateTime?   @map("settled_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  hotel    Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  stay     Stay          @relation(fields: [stayId], references: [id], onDelete: Restrict)
  charges  FolioCharge[]
  invoices Invoice[]
  payments Payment[]

  @@index([hotelId, status])
  @@map("folios")
}

model FolioCharge {
  id          String   @id @default(uuid()) @db.Uuid
  folioId     String   @map("folio_id") @db.Uuid
  orderId     String?  @map("order_id") @db.Uuid
  category    String   @db.VarChar(50)
  description String   @db.VarChar(200)
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  tax         Decimal  @default(0.00) @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  postedAt    DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)

  // Relations
  folio Folio  @relation(fields: [folioId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([folioId, postedAt])
  @@map("folio_charges")
}

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  hotelId       String   @map("hotel_id") @db.Uuid
  stayId        String   @map("stay_id") @db.Uuid
  folioId       String   @map("folio_id") @db.Uuid
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(50)
  invoiceDate   DateTime @default(now()) @map("invoice_date") @db.Timestamptz(6)
  subtotal      Decimal  @db.Decimal(10, 2)
  cgst          Decimal  @db.Decimal(10, 2)
  sgst          Decimal  @db.Decimal(10, 2)
  grandTotal    Decimal  @map("grand_total") @db.Decimal(10, 2)
  status        String   @default("ISSUED") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  stay     Stay      @relation(fields: [stayId], references: [id], onDelete: Restrict)
  folio    Folio     @relation(fields: [folioId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([hotelId, invoiceDate])
  @@index([folioId])
  @@map("invoices")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  hotelId           String        @map("hotel_id") @db.Uuid
  stayId            String        @map("stay_id") @db.Uuid
  folioId           String        @map("folio_id") @db.Uuid
  invoiceId         String?       @map("invoice_id") @db.Uuid
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR") @db.VarChar(10)
  method            String        @db.VarChar(40)
  provider          String?       @db.VarChar(40)
  providerReference String?       @map("provider_reference") @db.VarChar(100)
  status            PaymentStatus @default(SUCCESS)
  paidAt            DateTime      @default(now()) @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  hotel   Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  stay    Stay     @relation(fields: [stayId], references: [id], onDelete: Restrict)
  folio   Folio    @relation(fields: [folioId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([hotelId, status])
  @@index([folioId])
  @@map("payments")
}

model TaxConfig {
  id            String   @id @default(uuid()) @db.Uuid
  hotelId       String   @map("hotel_id") @db.Uuid
  taxCode       String   @map("tax_code") @db.VarChar(30)
  name          String   @db.VarChar(100)
  totalRate     Decimal  @default(5.00) @map("total_rate") @db.Decimal(5, 2)
  cgstRate      Decimal  @default(2.50) @map("cgst_rate") @db.Decimal(5, 2)
  sgstRate      Decimal  @default(2.50) @map("sgst_rate") @db.Decimal(5, 2)
  igstRate      Decimal  @default(0.00) @map("igst_rate") @db.Decimal(5, 2)
  active        Boolean  @default(true)
  effectiveDate DateTime @default(now()) @map("effective_date") @db.Timestamptz(6)

  // Relations
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  @@unique([hotelId, taxCode])
  @@map("tax_configs")
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS & AUDIT
// ─────────────────────────────────────────────────────────────

model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  hotelId       String    @map("hotel_id") @db.Uuid
  recipientType String    @map("recipient_type") @db.VarChar(20)
  guestId       String?   @map("guest_id") @db.Uuid
  staffUserId   String?   @map("staff_user_id") @db.Uuid
  type          String    @db.VarChar(50)
  title         String    @db.VarChar(120)
  message       String    @db.Text
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  hotel     Hotel      @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  guest     Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)
  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([hotelId, recipientType])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  hotelId     String   @map("hotel_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String   @map("entity_id") @db.VarChar(60)
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ipAddress   String?  @map("ip_address") @db.VarChar(50)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  hotel     Hotel      @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  actorUser StaffUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([hotelId, entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
